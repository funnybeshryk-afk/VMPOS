QMainWindow {
    background: #f4f6f9;
}

QWidget {
    background: #f4f6f9;
    color: #222;
    font-family: "Segoe UI";
    font-size: 14px;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 600;
    color: #222;
    padding-bottom: 8px;
}

QListWidget {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    outline: none;
    padding: 8px;
}

QListWidget::item {
    height: 42px;
    border-radius: 8px;
    padding-left: 14px;
}

QListWidget::item:selected {
    background: #2e7d32;
    color: white;
}

QPushButton {
    background: #2e7d32;
    color: white;
    border: none;
    border-radius: 8px;
    min-height: 40px;
    padding: 0 18px;
    font-weight: 600;
}

QPushButton:hover {
    background: #388e3c;
}

QLineEdit {
    background: white;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    min-height: 40px;
    padding: 0 12px;
}

QTableWidget {
    background: white;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    alternate-background-color: #f8fafc;
    selection-background-color: #d9f2df;
    selection-color: #222;
}

QHeaderView::section {
    background: #eef2f6;
    border: none;
    border-bottom: 1px solid #d0d7de;
    padding: 10px;
    font-weight: 600;
}

QPushButton#dangerButton {
    background: #d32f2f;
}

QPushButton#dangerButton:hover {
    background: #c62828;
}